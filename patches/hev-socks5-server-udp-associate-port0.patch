diff --git a/src/hev-socks5-udp-dispatcher.c b/src/hev-socks5-udp-dispatcher.c
new file mode 100644
index 0000000..bd58206
--- /dev/null
+++ b/src/hev-socks5-udp-dispatcher.c
@@ -0,0 +1,602 @@
+/*
+ ============================================================================
+ Name        : hev-socks5-udp-dispatcher.c
+ Author      : hev
+ Description : Shared SOCKS5 UDP dispatcher
+ ============================================================================
+ */
+
+#define _GNU_SOURCE
+#include <errno.h>
+#include <poll.h>
+#include <string.h>
+#include <unistd.h>
+#include <arpa/inet.h>
+
+#include <hev-task.h>
+#include <hev-task-io.h>
+#include <hev-task-io-pipe.h>
+#include <hev-task-io-socket.h>
+#include <hev-memory-allocator.h>
+
+#include "hev-config.h"
+#include "hev-compiler.h"
+#include "hev-logger.h"
+#include "hev-misc.h"
+#include "hev-traffic-stats.h"
+#include "core/src/hev-socks5-misc-priv.h"
+
+#include "hev-socks5-udp-dispatcher.h"
+
+#define UDP_BUF_SIZE 1500
+
+typedef struct _UdpPacket UdpPacket;
+
+struct _UdpPacket
+{
+    UdpPacket *next;
+    struct sockaddr_in6 dst;
+    size_t len;
+    char buf[UDP_BUF_SIZE];
+};
+
+static HevList session_list;
+static HevTask *dispatcher_task;
+static int dispatcher_fd = -1;
+static int quit_fds[2] = { -1, -1 };
+static int dispatcher_family = AF_INET6;
+static struct sockaddr_in6 dispatcher_addr;
+
+static int
+addr_ip_equal (const struct sockaddr_in6 *a, const struct sockaddr_in6 *b)
+{
+    return memcmp (&a->sin6_addr, &b->sin6_addr, sizeof (a->sin6_addr)) == 0;
+}
+
+static int
+addr_endpoint_equal (const struct sockaddr_in6 *a,
+                     const struct sockaddr_in6 *b)
+{
+    return (a->sin6_port == b->sin6_port) && addr_ip_equal (a, b);
+}
+
+static void
+sockaddr4_into_sockaddr6 (const struct sockaddr_in *src,
+                          struct sockaddr_in6 *dst)
+{
+    memset (dst, 0, sizeof (*dst));
+    dst->sin6_family = AF_INET6;
+    dst->sin6_port = src->sin_port;
+    dst->sin6_addr.s6_addr[10] = 0xff;
+    dst->sin6_addr.s6_addr[11] = 0xff;
+    memcpy (&dst->sin6_addr.s6_addr[12], &src->sin_addr, 4);
+}
+
+static void
+sockaddr6_into_sockaddr4 (const struct sockaddr_in6 *src,
+                          struct sockaddr_in *dst)
+{
+    memset (dst, 0, sizeof (*dst));
+    dst->sin_family = AF_INET;
+    dst->sin_port = src->sin6_port;
+    memcpy (&dst->sin_addr, &src->sin6_addr.s6_addr[12], 4);
+}
+
+static void
+session_queue_push (HevSocks5Session *session, UdpPacket *packet)
+{
+    packet->next = NULL;
+    if (session->udp_queue_tail) {
+        ((UdpPacket *)session->udp_queue_tail)->next = packet;
+        session->udp_queue_tail = packet;
+    } else {
+        session->udp_queue_head = packet;
+        session->udp_queue_tail = packet;
+    }
+}
+
+static UdpPacket *
+session_queue_pop (HevSocks5Session *session)
+{
+    UdpPacket *packet = session->udp_queue_head;
+
+    if (!packet)
+        return NULL;
+
+    session->udp_queue_head = packet->next;
+    if (!session->udp_queue_head)
+        session->udp_queue_tail = NULL;
+
+    return packet;
+}
+
+static void
+session_queue_clear (HevSocks5Session *session)
+{
+    UdpPacket *packet;
+
+    while ((packet = session_queue_pop (session)))
+        hev_free (packet);
+}
+
+static HevSocks5Session *
+lookup_session (const struct sockaddr_in6 *client)
+{
+    HevListNode *node;
+
+    for (node = hev_list_first (&session_list); node;
+         node = hev_list_node_next (node)) {
+        HevSocks5Session *session;
+
+        session = container_of (node, HevSocks5Session, udp_node);
+        if (session->udp_client_known &&
+            addr_endpoint_equal (&session->udp_client, client))
+            return session;
+    }
+
+    for (node = hev_list_first (&session_list); node;
+         node = hev_list_node_next (node)) {
+        HevSocks5Session *session;
+
+        session = container_of (node, HevSocks5Session, udp_node);
+        if (!session->udp_client_known &&
+            addr_ip_equal (&session->udp_peer, client)) {
+            session->udp_client = *client;
+            session->udp_client_known = 1;
+            return session;
+        }
+    }
+
+    return NULL;
+}
+
+static int
+parse_client_packet (char *buf, ssize_t len, UdpPacket *packet)
+{
+    HevSocks5UDPHdr *udp = (HevSocks5UDPHdr *)buf;
+    int family = AF_UNSPEC;
+    int addrlen;
+    int doff;
+    int res;
+
+    if (len < 4)
+        return -1;
+
+    addrlen = hev_socks5_addr_len (&udp->addr);
+    if (addrlen <= 0)
+        return -1;
+
+    doff = 3 + addrlen;
+    if (doff > len)
+        return -1;
+
+    res = hev_socks5_addr_into_sockaddr6 (&udp->addr, &packet->dst, &family);
+    if (res < 0)
+        return -1;
+
+    packet->len = len - doff;
+    memcpy (packet->buf, buf + doff, packet->len);
+
+    return 0;
+}
+
+static void
+dispatcher_task_entry (void *data)
+{
+    HevTask *task = hev_task_self ();
+    (void)data;
+
+    hev_task_add_fd (task, dispatcher_fd, POLLIN);
+    hev_task_add_fd (task, quit_fds[0], POLLIN);
+
+    for (;;) {
+        struct sockaddr_in6 client;
+        struct sockaddr_in client4;
+        struct sockaddr *sap;
+        socklen_t alen;
+        char buf[UDP_BUF_SIZE];
+        ssize_t len;
+        char val;
+
+        if (read (quit_fds[0], &val, sizeof (val)) > 0)
+            break;
+
+        sap = (dispatcher_family == AF_INET) ? (struct sockaddr *)&client4 :
+                                               (struct sockaddr *)&client;
+        alen = (dispatcher_family == AF_INET) ? sizeof (client4) :
+                                                sizeof (client);
+        len = hev_task_io_socket_recvfrom (
+            dispatcher_fd, buf, sizeof (buf), MSG_DONTWAIT,
+            sap, &alen, NULL, NULL);
+        if (len <= 0) {
+            hev_task_yield (HEV_TASK_WAITIO);
+            continue;
+        }
+
+        for (;;) {
+            HevSocks5Session *session;
+            UdpPacket *packet;
+
+            if (dispatcher_family == AF_INET)
+                sockaddr4_into_sockaddr6 (&client4, &client);
+
+            session = lookup_session (&client);
+            if (session) {
+                packet = hev_malloc (sizeof (UdpPacket));
+                if (packet && parse_client_packet (buf, len, packet) == 0) {
+                    session_queue_push (session, packet);
+                    hev_task_wakeup (session->task);
+                } else if (packet) {
+                    hev_free (packet);
+                }
+            }
+
+            sap = (dispatcher_family == AF_INET) ? (struct sockaddr *)&client4 :
+                                                   (struct sockaddr *)&client;
+            alen = (dispatcher_family == AF_INET) ? sizeof (client4) :
+                                                    sizeof (client);
+            len = hev_task_io_socket_recvfrom (
+                dispatcher_fd, buf, sizeof (buf), MSG_DONTWAIT,
+                sap, &alen, NULL, NULL);
+            if (len <= 0)
+                break;
+        }
+    }
+
+    hev_task_del_fd (task, quit_fds[0]);
+    hev_task_del_fd (task, dispatcher_fd);
+    close (dispatcher_fd);
+    close (quit_fds[0]);
+    close (quit_fds[1]);
+    dispatcher_fd = -1;
+    quit_fds[0] = -1;
+    quit_fds[1] = -1;
+    dispatcher_task = NULL;
+}
+
+static int
+dispatcher_bind (HevSocks5Session *session)
+{
+    struct sockaddr_in6 addr;
+    const char *saddr;
+    socklen_t alen;
+    int ipv6_only;
+    int sport;
+    int zero = 0;
+    int one = 1;
+    int res;
+
+    saddr = hev_config_get_udp_listen_address ();
+    alen = sizeof (addr);
+    if (saddr)
+        res = hev_netaddr_resolve (&addr, saddr, NULL);
+    else
+        res = getsockname (HEV_SOCKS5 (session)->fd, (struct sockaddr *)&addr,
+                           &alen);
+    if (res < 0)
+        goto exit;
+
+    sport = hev_config_get_udp_listen_port ();
+    addr.sin6_port = htons (sport);
+    dispatcher_family = IN6_IS_ADDR_V4MAPPED (&addr.sin6_addr) ? AF_INET :
+                                                               AF_INET6;
+    dispatcher_fd = hev_task_io_socket_socket (dispatcher_family, SOCK_DGRAM,
+                                              0);
+    if (dispatcher_fd < 0)
+        return -1;
+
+    if (dispatcher_family == AF_INET6) {
+        res = setsockopt (dispatcher_fd, IPPROTO_IPV6, IPV6_V6ONLY, &zero,
+                          sizeof (zero));
+        if (res < 0)
+            goto exit;
+    }
+
+    res = setsockopt (dispatcher_fd, SOL_SOCKET, SO_REUSEADDR, &one,
+                      sizeof (one));
+    if (res < 0)
+        goto exit;
+
+#ifdef SO_REUSEPORT
+    res = setsockopt (dispatcher_fd, SOL_SOCKET, SO_REUSEPORT, &one,
+                      sizeof (one));
+    if (res < 0)
+        goto exit;
+#endif
+
+    ipv6_only = hev_config_get_listen_ipv6_only ();
+    if ((dispatcher_family == AF_INET6) && ipv6_only) {
+        res = setsockopt (dispatcher_fd, IPPROTO_IPV6, IPV6_V6ONLY, &one,
+                          sizeof (one));
+        if (res < 0)
+            goto exit;
+    }
+
+    if (dispatcher_family == AF_INET) {
+        struct sockaddr_in addr4;
+
+        sockaddr6_into_sockaddr4 (&addr, &addr4);
+        res = bind (dispatcher_fd, (struct sockaddr *)&addr4, sizeof (addr4));
+    } else {
+        res = bind (dispatcher_fd, (struct sockaddr *)&addr, sizeof (addr));
+    }
+    if (res < 0)
+        goto exit;
+
+    if (dispatcher_family == AF_INET) {
+        struct sockaddr_in addr4;
+
+        alen = sizeof (addr4);
+        res = getsockname (dispatcher_fd, (struct sockaddr *)&addr4, &alen);
+        sockaddr4_into_sockaddr6 (&addr4, &dispatcher_addr);
+    } else {
+        alen = sizeof (dispatcher_addr);
+        res = getsockname (dispatcher_fd, (struct sockaddr *)&dispatcher_addr,
+                           &alen);
+    }
+    if (res < 0)
+        goto exit;
+
+    dispatcher_task = hev_task_new (-1);
+    if (!dispatcher_task)
+        goto exit;
+
+    res = hev_task_io_pipe_pipe (quit_fds);
+    if (res < 0) {
+        hev_task_unref (dispatcher_task);
+        dispatcher_task = NULL;
+        goto exit;
+    }
+
+    hev_task_run (dispatcher_task, dispatcher_task_entry, NULL);
+
+    return 0;
+
+exit:
+    close (dispatcher_fd);
+    dispatcher_fd = -1;
+    return -1;
+}
+
+static void
+apply_public_address (struct sockaddr_in6 *addr)
+{
+    const char *saddr;
+    int family;
+    int sport;
+    int res;
+
+    family = IN6_IS_ADDR_V4MAPPED (&addr->sin6_addr) ? AF_INET : AF_INET6;
+    saddr = hev_config_get_udp_public_address (family);
+    if (!saddr)
+        return;
+
+    sport = addr->sin6_port;
+    res = hev_netaddr_resolve (addr, saddr, NULL);
+    addr->sin6_port = sport;
+    if (res < 0)
+        return;
+}
+
+int
+hev_socks5_udp_dispatcher_prepare (HevSocks5Session *session, int sock,
+                                   struct sockaddr_in6 *src)
+{
+    struct sockaddr_in6 client = *src;
+    struct sockaddr_in6 peer;
+    socklen_t alen;
+    int res;
+
+    (void)sock;
+
+    if (!hev_config_get_udp_listen_port_single ())
+        return 0;
+
+    if (dispatcher_fd < 0) {
+        res = dispatcher_bind (session);
+        if (res < 0)
+            return -1;
+    }
+
+    alen = sizeof (peer);
+    res = getpeername (HEV_SOCKS5 (session)->fd, (struct sockaddr *)&peer,
+                       &alen);
+    if (res < 0)
+        return -1;
+
+    if (hev_netaddr_is_any (&client)) {
+        client = peer;
+        client.sin6_port = src->sin6_port;
+    }
+
+    session->udp_peer = peer;
+    session->udp_client = client;
+    session->udp_client_known = !!client.sin6_port;
+    session->udp_dispatcher = 1;
+    session->udp_dispatcher_registered = 1;
+    session->udp_remote_bound = 0;
+
+    hev_list_add_tail (&session_list, &session->udp_node);
+
+    *src = dispatcher_addr;
+    apply_public_address (src);
+
+    return 1;
+}
+
+void
+hev_socks5_udp_dispatcher_unregister (HevSocks5Session *session)
+{
+    if (!session->udp_dispatcher_registered)
+        return;
+
+    hev_list_del (&session_list, &session->udp_node);
+    session->udp_dispatcher_registered = 0;
+    session_queue_clear (session);
+}
+
+void
+hev_socks5_udp_dispatcher_stop (void)
+{
+    char val = 's';
+
+    if (quit_fds[1] < 0)
+        return;
+
+    if (write (quit_fds[1], &val, sizeof (val)) < 0)
+        LOG_E ("socks5 udp dispatcher write quit");
+}
+
+static int
+dispatcher_yielder (HevTaskYieldType type, void *data)
+{
+    HevSocks5 *self = data;
+    ssize_t res;
+    char buf;
+
+    res = recv (self->fd, &buf, sizeof (buf), 0);
+    if ((res == 0) || ((res < 0) && (errno != EAGAIN))) {
+        hev_socks5_set_timeout (self, 0);
+        return -1;
+    }
+
+    return hev_socks5_task_io_yielder (type, data);
+}
+
+static int
+send_remote_packet (HevSocks5Session *session, int fd, UdpPacket *packet)
+{
+    HevSocks5Class *klass;
+    ssize_t res;
+
+    if (!session->udp_remote_bound) {
+        klass = HEV_SOCKS5_CLASS (HEV_OBJECT_GET_CLASS (session));
+        res = klass->binder (HEV_SOCKS5 (session), fd,
+                             (struct sockaddr *)&packet->dst);
+        if (res < 0)
+            return -1;
+        session->udp_remote_bound = 1;
+    }
+
+    res = hev_task_io_socket_sendto (fd, packet->buf, packet->len, MSG_WAITALL,
+                                     (struct sockaddr *)&packet->dst,
+                                     sizeof (packet->dst), dispatcher_yielder,
+                                     session);
+    if (res <= 0)
+        return -1;
+
+    hev_socks5_traffic_stats_add_udp_upload (packet->len);
+
+    return 1;
+}
+
+static int
+send_client_packet (HevSocks5Session *session, const char *buf, ssize_t len,
+                    struct sockaddr_in6 *remote)
+{
+    HevSocks5UDPHdr udp;
+    struct iovec iov[3];
+    struct msghdr mh;
+    struct sockaddr_in client4;
+    char abuf[19];
+    ssize_t res;
+    int alen;
+
+    if (!session->udp_client_known)
+        return 0;
+
+    if (dispatcher_fd < 0)
+        return -1;
+
+    alen = hev_socks5_addr_from_sockaddr6 (&udp.addr, remote);
+    udp.datlen = 0;
+    udp.hdrlen = 0;
+
+    memcpy (abuf, &udp.addr, alen);
+
+    iov[0].iov_base = &udp;
+    iov[0].iov_len = 3;
+    iov[1].iov_base = abuf;
+    iov[1].iov_len = alen;
+    iov[2].iov_base = (void *)buf;
+    iov[2].iov_len = len;
+
+    if (dispatcher_family == AF_INET) {
+        sockaddr6_into_sockaddr4 (&session->udp_client, &client4);
+        mh.msg_name = &client4;
+        mh.msg_namelen = sizeof (client4);
+    } else {
+        mh.msg_name = &session->udp_client;
+        mh.msg_namelen = sizeof (session->udp_client);
+    }
+    mh.msg_control = NULL;
+    mh.msg_controllen = 0;
+    mh.msg_iov = iov;
+    mh.msg_iovlen = 3;
+
+    res = hev_task_io_socket_sendmsg (dispatcher_fd, &mh, MSG_WAITALL,
+                                      dispatcher_yielder, session);
+    if (res <= 0)
+        return -1;
+
+    hev_socks5_traffic_stats_add_udp_download (len);
+
+    return 1;
+}
+
+int
+hev_socks5_udp_dispatcher_splice (HevSocks5UDP *udp, int fd)
+{
+    HevSocks5Session *session = HEV_SOCKS5_SESSION (udp);
+    HevTask *task = hev_task_self ();
+    int res_f = 1;
+    int res_b = 1;
+
+    hev_task_add_fd (task, fd, POLLIN | POLLOUT);
+
+    for (;;) {
+        HevTaskYieldType type;
+        UdpPacket *packet;
+
+        res_f = 0;
+        while ((packet = session_queue_pop (session))) {
+            res_f = send_remote_packet (session, fd, packet);
+            hev_free (packet);
+            if (res_f < 0)
+                break;
+        }
+
+        res_b = 0;
+        for (;;) {
+            struct sockaddr_in6 remote;
+            socklen_t alen = sizeof (remote);
+            char buf[UDP_BUF_SIZE];
+            ssize_t len;
+
+            len = hev_task_io_socket_recvfrom (
+                fd, buf, sizeof (buf), MSG_DONTWAIT,
+                (struct sockaddr *)&remote, &alen, dispatcher_yielder,
+                session);
+            if (len <= 0)
+                break;
+
+            res_b = send_client_packet (session, buf, len, &remote);
+            if (res_b < 0)
+                break;
+        }
+
+        if (res_f > 0 || res_b > 0)
+            type = HEV_TASK_YIELD;
+        else if ((res_f == 0) && (res_b == 0))
+            type = HEV_TASK_WAITIO;
+        else
+            break;
+
+        if (dispatcher_yielder (type, session))
+            break;
+    }
+
+    hev_socks5_udp_dispatcher_unregister (session);
+
+    return 0;
+}
