@@ -16,2 +25,35 @@
 #define task_io_yielder hev_socks5_task_io_yielder
+#define TCP_BUF_SIZE 8192
+
+static int
+tcp_copy_once (HevSocks5TCP *self, int in, int out, int upload, char *buf)
+{
+    ssize_t len;
+    ssize_t off = 0;
+
+    len = recv (in, buf, TCP_BUF_SIZE, MSG_DONTWAIT);
+    if (len <= 0) {
+        if ((len < 0) && (errno == EAGAIN))
+            return 0;
+        shutdown (out, SHUT_WR);
+        return -1;
+    }
+
+    while (off < len) {
+        ssize_t res;
+
+        res = hev_task_io_socket_send (out, buf + off, len - off, 0,
+                                       task_io_yielder, self);
+        if (res <= 0)
+            return -1;
+        off += res;
+    }
+
+    if (upload)
+        hev_socks5_traffic_stats_add_tcp_upload (len);
+    else
+        hev_socks5_traffic_stats_add_tcp_download (len);
+
+    return 1;
+}
 
