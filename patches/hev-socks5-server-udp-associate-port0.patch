@@ -0,0 +1,75 @@
+/*
+ ============================================================================
+ Name        : hev-traffic-stats.c
+ Description : Traffic stats
+ ============================================================================
+ */
+
+#include <stdatomic.h>
+
+#include "hev-traffic-stats.h"
+#include "hev-main.h"
+
+static atomic_ullong tcp_upload;
+static atomic_ullong tcp_download;
+static atomic_ullong udp_upload;
+static atomic_ullong udp_download;
+
+void
+hev_socks5_traffic_stats_add_tcp_upload (uint64_t bytes)
+{
+    atomic_fetch_add_explicit (&tcp_upload, bytes, memory_order_relaxed);
+}
+
+void
+hev_socks5_traffic_stats_add_tcp_download (uint64_t bytes)
+{
+    atomic_fetch_add_explicit (&tcp_download, bytes, memory_order_relaxed);
+}
+
+void
+hev_socks5_traffic_stats_add_udp_upload (uint64_t bytes)
+{
+    atomic_fetch_add_explicit (&udp_upload, bytes, memory_order_relaxed);
+}
+
+void
+hev_socks5_traffic_stats_add_udp_download (uint64_t bytes)
+{
+    atomic_fetch_add_explicit (&udp_download, bytes, memory_order_relaxed);
+}
+
+void
+hev_socks5_traffic_stats_reset (void)
+{
+    atomic_store_explicit (&tcp_upload, 0, memory_order_relaxed);
+    atomic_store_explicit (&tcp_download, 0, memory_order_relaxed);
+    atomic_store_explicit (&udp_upload, 0, memory_order_relaxed);
+    atomic_store_explicit (&udp_download, 0, memory_order_relaxed);
+}
+
+void
+hev_socks5_server_get_traffic_stats (unsigned long long *tcp_upload_bytes,
+                                     unsigned long long *tcp_download_bytes,
+                                     unsigned long long *udp_upload_bytes,
+                                     unsigned long long *udp_download_bytes)
+{
+    if (tcp_upload_bytes)
+        *tcp_upload_bytes = atomic_load_explicit (&tcp_upload,
+                                                 memory_order_relaxed);
+    if (tcp_download_bytes)
+        *tcp_download_bytes = atomic_load_explicit (&tcp_download,
+                                                   memory_order_relaxed);
+    if (udp_upload_bytes)
+        *udp_upload_bytes = atomic_load_explicit (&udp_upload,
+                                                 memory_order_relaxed);
+    if (udp_download_bytes)
+        *udp_download_bytes = atomic_load_explicit (&udp_download,
+                                                   memory_order_relaxed);
+}
+
+void
+hev_socks5_server_reset_traffic_stats (void)
+{
+    hev_socks5_traffic_stats_reset ();
+}
